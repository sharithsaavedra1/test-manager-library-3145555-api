#!/usr/bin/env php
<?php

$bootstrap = require __DIR__ . '/bootstrap/app.php';

use App\Application\Ports\PasswordHasherInterface;
use App\Application\Ports\UserRepositoryInterface;
use App\Domain\Model\User;
use Illuminate\Support\Str;

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        echo "Running database migrations...\n";
        $migration = require __DIR__ . '/database/migrations/2026_10_14_000000_create_library_schema_and_tables.php';
        $migration->up();
        echo "Migrations executed successfully! (Tables, constraints and seed categories ready)\n";
        break;

    case 'migrate:rollback':
        echo "Rolling back migrations...\n";
        $migration = require __DIR__ . '/database/migrations/2026_10_14_000000_create_library_schema_and_tables.php';
        $migration->down();
        echo "Rollback completed.\n";
        break;

    case 'seed:admin':
        // T-13 y D-10: El administrador inicial no lo siembra la base: lo crea el arranque desde entorno
        $adminUsername = env('ADMIN_USERNAME', 'admin');
        $adminPassword = env('ADMIN_PASSWORD', 'AdminPassword123!');

        /** @var UserRepositoryInterface $userRepo */
        $userRepo = $bootstrap['container']->make(UserRepositoryInterface::class);
        /** @var PasswordHasherInterface $hasher */
        $hasher = $bootstrap['container']->make(PasswordHasherInterface::class);

        $normalized = strtolower(trim($adminUsername));
        $existing = $userRepo->findByUsername($normalized);

        if ($existing === null) {
            $adminUser = new User((string)Str::uuid(), $normalized, $hasher->hash($adminPassword), User::ROLE_ADMIN);
            $userRepo->save($adminUser);
            echo "Admin user [{$normalized}] seeded successfully with credentials from environment!\n";
        } else {
            \Illuminate\Support\Facades\DB::statement(
                'UPDATE library.user SET password_hash = ? WHERE username = ?',
                [$hasher->hash($adminPassword), $normalized]
            );
            echo "Admin user [{$normalized}] password updated successfully from environment!\n";
        }
        break;

    case 'serve':
        $host = env('APP_HOST', '127.0.0.1');
        $port = env('APP_PORT', '8000');
        echo "Manager Library API running on http://{$host}:{$port}\n";
        passthru("\"" . PHP_BINARY . "\" -S {$host}:{$port} -t \"" . __DIR__ . "/public\" \"" . __DIR__ . "/public/index.php\"");
        break;

    default:
        echo "Usage: php artisan [migrate | migrate:rollback | seed:admin | serve]\n";
        break;
}
